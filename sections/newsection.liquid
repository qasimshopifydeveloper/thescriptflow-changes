{% comment %}
  ============================================================
  SK Nicotine Quiz — "Should I take 2mg or 4mg?"
  SectionKit | sk-nicotine-quiz
  ------------------------------------------------------------
  Features:
  - 3 layout variations via select setting
  - Desktop: side-by-side grid (1600/1400/1200/1000px width options)
  - Tablet 640–991px: side-by-side smaller
  - Mobile ≤639px: touch swipe slider, 1.5 cards peek
  - Theme CSS variable integration for fonts & colors
  - Highlighted text with glow effect
  - Full schema with padding, margin, background, border controls
  - Lazy loaded images with responsive srcset
  ============================================================
{% endcomment %}

{%- liquid
  assign section_layout      = section.settings.section_layout
  assign content_width       = section.settings.content_width
  assign padding_top         = section.settings.padding_top
  assign padding_bottom      = section.settings.padding_bottom
  assign padding_horizontal  = section.settings.padding_horizontal
  assign padding_top_mobile  = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign margin_top          = section.settings.margin_top
  assign margin_bottom       = section.settings.margin_bottom
  assign background_color    = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign border_color        = section.settings.border_color
  assign border_thickness    = section.settings.border_thickness
  assign card_bg             = section.settings.card_bg
  assign card_radius         = section.settings.card_radius
  assign card_border_thickness = section.settings.card_border_thickness
  assign card_border_color   = section.settings.card_border_color
  assign card_shadow         = section.settings.card_shadow
  assign gap_desktop         = section.settings.gap_desktop
  assign gap_tablet          = section.settings.gap_tablet
  assign lazy                = section.settings.lazy
  assign heading_text        = section.settings.heading
  assign heading_highlight   = section.settings.highlight
-%}

{% style %}

  .sk-nq-{{ section.id }} {
    background-color: {{ background_color }};
    {% if background_gradient != blank %}
      background-image: {{ background_gradient }};
    {% endif %}
    border-top: {{ border_thickness }}px solid {{ border_color }};
    border-bottom: {{ border_thickness }}px solid {{ border_color }};
    margin-top: {{ margin_top }}px;
    margin-bottom: {{ margin_bottom }}px;
    padding-top: {{ padding_top_mobile }}rem;
    padding-bottom: {{ padding_bottom_mobile }}rem;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .sk-nq-{{ section.id }} .sk-nq__inner {
    max-width: {{ content_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Heading ── */
  .sk-nq-{{ section.id }} .sk-nq__heading {
    text-align: center;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    font-size: clamp(1.6rem, 3.5vw, 2.8rem);
    line-height: var(--font-body-line-height);
    letter-spacing: var(--font-body-letter-spacing);
    margin-bottom: 2rem;
  }

  .sk-nq-{{ section.id }} .sk-nq__heading-highlight {
    color: #ceff43;
    text-shadow: 0px 0px var(--glow-standard, 8px) #ceff43 !important;
    transition: color var(--animation-smooth);
    font-style: normal;
  }

  /* ── Grid (desktop default) ── */
  .sk-nq-{{ section.id }} .sk-nq__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ gap_desktop }}rem;
  }

  .sk-nq-{{ section.id }} .sk-nq__track {
    display: contents;
  }

  .sk-nq-{{ section.id }} .sk-nq__slide {
    display: block;
  }

  /* ── Image ── */
  .sk-nq-{{ section.id }} .sk-nq__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: {{ card_radius }}px;
    background: {{ card_bg }};
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sk-nq-{{ section.id }} .sk-nq__img img,
  .sk-nq-{{ section.id }} .sk-nq__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sk-nq-{{ section.id }} .sk-nq__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }

  /* ── Text block ── */
  .sk-nq-{{ section.id }} .sk-nq__text {
    margin-top: 1rem;
  }

  .sk-nq-{{ section.id }} .sk-nq__label {
    line-height: 1.25;
    font-size: var(--fluid-lg-to-2xl);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--font-heading-letter-spacing);
    line-height: var(--font-heading-line-height);
    text-transform: var(--font-heading-text-transform);
    color: #ffffff;
    word-break: break-word;
    margin: 0 0 0.4rem;
    text-align: center;
  }

  .sk-nq-{{ section.id }} .sk-nq__label-highlight {
    color: #ceff43;
    text-shadow: 0px 0px var(--glow-standard, 8px) #ceff43 !important;
    transition: color var(--animation-smooth);
    font-style: normal;
  }

  .sk-nq-{{ section.id }} .sk-nq__body {
    line-height: 1.6;
    text-align: center;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    font-size: var(--text-base);
    line-height: var(--font-body-line-height);
    letter-spacing: var(--font-body-letter-spacing);
    margin: 0;
  }

  /* ── Card shadow ── */
  {% if card_shadow %}
    .sk-nq-{{ section.id }} .sk-nq__slide {
      box-shadow: rgba(0,0,0,0.12) 0px 6px 20px;
      border-radius: {{ card_radius }}px;
      padding-bottom: 1rem;
    }
  {% endif %}

  /* ── Card border ── */
  {% if card_border_thickness > 0 %}
    .sk-nq-{{ section.id }} .sk-nq__img {
      border: {{ card_border_thickness }}px solid {{ card_border_color }};
    }
  {% endif %}

  /* ────────────────────────────────
     LAYOUT 2 — Split Screen
  ──────────────────────────────── */
  {% if section_layout == 'layout2' %}
    .sk-nq-{{ section.id }} .sk-nq__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: relative;
      overflow: hidden;
    }
    .sk-nq-{{ section.id }} .sk-nq__img {
      aspect-ratio: 3 / 4;
      border-radius: 0;
    }
    .sk-nq-{{ section.id }} .sk-nq__text {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      margin: 0;
      padding: 1.5rem;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
    }
    .sk-nq-{{ section.id }} .sk-nq__label {
      color: #ffffff;
      text-align: left;
    }
    .sk-nq-{{ section.id }} .sk-nq__body {
      color: rgba(255,255,255,0.8);
      text-align: left;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide:first-child {
      border-right: 1px solid rgba(255,255,255,0.1);
    }
  {% endif %}

  /* ────────────────────────────────
     LAYOUT 3 — Card with Number Badge
  ──────────────────────────────── */
  {% if section_layout == 'layout3' %}
    .sk-nq-{{ section.id }} .sk-nq__grid {
      grid-template-columns: 1fr 1fr;
      gap: {{ gap_desktop }}rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide {
      background: {{ card_bg }};
      border-radius: {{ card_radius }}px;
      overflow: hidden;
      padding-bottom: 1.5rem;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .sk-nq-{{ section.id }} .sk-nq__img {
      border-radius: 0;
    }
    .sk-nq-{{ section.id }} .sk-nq__text {
      padding: 0 1.25rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__badge {
      display: inline-block;
      background: #ceff43;
      color: #000;
      font-weight: 800;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
      margin-top: 1rem;
      text-transform: uppercase;
    }
    .sk-nq-{{ section.id }} .sk-nq__label {
      text-align: left;
    }
    .sk-nq-{{ section.id }} .sk-nq__body {
      text-align: left;
    }
  {% endif %}

  /* ────────────────────────────────
     TABLET 640–991px
  ──────────────────────────────── */
  @media (min-width: 640px) and (max-width: 991px) {
    .sk-nq-{{ section.id }} {
      padding-top: {{ padding_top_mobile }}rem;
      padding-bottom: {{ padding_bottom_mobile }}rem;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__grid {
      grid-template-columns: 1fr 1fr;
      gap: {{ gap_tablet }}rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__track {
      display: contents;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide {
      min-width: unset;
    }
  }

  /* ────────────────────────────────
     MOBILE ≤639px — Swipe Slider
  ──────────────────────────────── */
  @media (max-width: 639px) {
    .sk-nq-{{ section.id }} {
      padding-top: {{ padding_top_mobile }}rem;
      padding-bottom: {{ padding_bottom_mobile }}rem;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__grid {
      display: block;
      overflow: hidden;
      position: relative;
    }
    .sk-nq-{{ section.id }} .sk-nq__track {
      display: flex;
      transition: transform 0.4s ease;
      will-change: transform;
      gap: 0.75rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide {
      min-width: 75%;
      flex-shrink: 0;
    }
    .sk-nq-{{ section.id }} .sk-nq__body {
      text-align: left;
    }
    {% if section_layout == 'layout2' %}
      .sk-nq-{{ section.id }} .sk-nq__img {
        aspect-ratio: 4 / 3;
      }
      .sk-nq-{{ section.id }} .sk-nq__slide:first-child {
        border-right: none;
      }
    {% endif %}
  }

  /* ────────────────────────────────
     DESKTOP ≥992px
  ──────────────────────────────── */
  @media (min-width: 992px) {
    .sk-nq-{{ section.id }} {
      padding-top: {{ padding_top }}rem;
      padding-bottom: {{ padding_bottom }}rem;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }
    .sk-nq-{{ section.id }} .sk-nq__track {
      display: contents;
    }
    .sk-nq-{{ section.id }} .sk-nq__slide {
      min-width: unset;
      flex-shrink: unset;
    }
  }

{% endstyle %}

<div class="sk-nq-{{ section.id }}" id="sk-nq-{{ section.id }}">
  <div class="sk-nq__inner">

    {% if heading_text != blank or heading_highlight != blank %}
      <p class="sk-nq__heading">
        {% if heading_text != blank %}{{ heading_text }} {% endif %}
        {% if heading_highlight != blank %}
          <em class="sk-nq__heading-highlight">{{ heading_highlight }}</em>
        {% endif %}
      </p>
    {% endif %}

    <div class="sk-nq__grid">
      <div class="sk-nq__track" id="skNqTrack-{{ section.id }}">

        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {%- assign block_index = forloop.index -%}
            <div class="sk-nq__slide" {{ block.shopify_attributes }}>

              <div class="sk-nq__img">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: lazy,
                      widths: '400, 600, 900',
                      sizes: '(max-width: 639px) 75vw, (max-width: 991px) 50vw, 50vw',
                      alt: block.settings.label
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'sk-nq__placeholder' }}
                {% endif %}
              </div>

              <div class="sk-nq__text">

                {% if section_layout == 'layout3' %}
                  <span class="sk-nq__badge">
                    {% if block_index == 1 %}Option 1{% else %}Option 2{% endif %}
                  </span>
                {% endif %}

                {% if block.settings.label != blank %}
                  <p class="sk-nq__label">
                    {%- assign label_parts = block.settings.label | split: block.settings.highlight -%}
                    {% if block.settings.highlight != blank and label_parts.size > 1 %}
                      {{ label_parts[0] }}<em class="sk-nq__label-highlight">{{ block.settings.highlight }}</em>{{ label_parts[1] }}
                    {% else %}
                      {{ block.settings.label }}
                    {% endif %}
                  </p>
                {% endif %}

                {% if block.settings.body != blank %}
                  <p class="sk-nq__body">{{ block.settings.body }}</p>
                {% endif %}

              </div>

            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('skNqTrack-{{ section.id }}');
    if (!track) return;

    var cur = 0;
    var startX = 0;
    var isDragging = false;

    function isMobile() {
      return window.innerWidth <= 639;
    }

    function goTo(index) {
      var total = track.children.length;
      if (index < 0) index = 0;
      if (index >= total) index = total - 1;
      cur = index;
      var gap = 12;
      track.style.transform = 'translateX(calc(-' + (cur * 75) + '% - ' + (cur * gap) + 'px))';
    }

    function onStart(x) {
      if (!isMobile()) return;
      startX = x;
      isDragging = true;
    }

    function onEnd(x) {
      if (!isDragging || !isMobile()) return;
      isDragging = false;
      var dx = x - startX;
      if (Math.abs(dx) > 40) {
        if (dx < 0) goTo(cur + 1);
        else goTo(cur - 1);
      }
    }

    track.addEventListener('touchstart', function (e) { onStart(e.touches[0].clientX); }, { passive: true });
    track.addEventListener('touchend', function (e) { onEnd(e.changedTouches[0].clientX); }, { passive: true });
    track.addEventListener('mousedown', function (e) { onStart(e.clientX); });
    window.addEventListener('mouseup', function (e) { onEnd(e.clientX); });

    window.addEventListener('resize', function () {
      if (!isMobile()) {
        track.style.transform = '';
        cur = 0;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "SK Image with Text #28",
  "tag": "section",
  "class": "sk-nicotine-quiz-section",
  "settings": [

    {
      "type": "header",
      "content": "Layout"
